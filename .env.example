# Local dev only — production values are set as Worker secrets/vars via
# the Cloudflare dashboard or `wrangler secret put <NAME>`, never
# committed. Copy this file to `.env` for `wrangler dev` / the seed
# script to pick up locally.
#
# Names match the main criticalsandfumbles.com site's convention on
# purpose — same Sanity project/dataset, settings kept aligned across
# both repos.

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-06-01
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
